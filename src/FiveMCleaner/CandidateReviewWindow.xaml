<Window x:Class="FiveMCleaner.CandidateReviewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Revisar candidatos — nenhuma exclusão realizada" Width="1000" Height="620" MinWidth="760" MinHeight="500" WindowStartupLocation="CenterOwner" Background="#080F1B" FontFamily="Segoe UI">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,16"><TextBlock Text="O nome é uma pista. Confirme o arquivo que você reconhece." FontSize="21" FontWeight="SemiBold"/><TextBlock x:Name="Summary" Margin="0,10,0,0" Foreground="#89A9CD"/><TextBlock Text="Selecione somente um arquivo que você sabe pertencer ao software. Nada será aberto ou executado. Arquivos pessoais desconhecidos devem permanecer preservados." Margin="0,8,0,0"/></StackPanel>
  <DataGrid x:Name="Candidates" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="Candidate_Changed" Background="#101D30" RowBackground="#172941" AlternatingRowBackground="#1C304A" Foreground="#E6EFFA" GridLinesVisibility="None" HeadersVisibility="Column" BorderThickness="0">
   <DataGrid.Resources><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#223D5C"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="8"/></Style></DataGrid.Resources>
   <DataGrid.Columns><DataGridTextColumn Header="Caminho do candidato (não é identificação confirmada)" Binding="{Binding Path}" Width="*"/><DataGridTextColumn Header="Tamanho" Binding="{Binding SizeDisplay}" Width="120"/><DataGridTextColumn Header="Alterado em" Binding="{Binding ModifiedDisplay}" Width="150"/></DataGrid.Columns>
  </DataGrid>
  <StackPanel Grid.Row="2" Margin="0,14,0,10"><TextBox x:Name="CandidatePath" IsReadOnly="True" TextWrapping="Wrap"/><CheckBox x:Name="Recognized" Content="Reconheço este arquivo como parte do software que quero remover."/><TextBlock Text="A confirmação autoriza a análise desse conteúdo e de cópias idênticas por SHA-256. A exclusão e cada componente relacionado ainda exigirão sua seleção e confirmação na tela principal." Foreground="#89A9CD"/></StackPanel>
  <WrapPanel Grid.Row="3" HorizontalAlignment="Right"><Button Content="Voltar sem autorizar" IsCancel="True"/><Button Content="Confirmar arquivo e analisar cópias" Click="Confirm_Click"/></WrapPanel>
 </Grid>
</Window>
