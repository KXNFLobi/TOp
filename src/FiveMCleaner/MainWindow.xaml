<Window x:Class="FiveMCleaner.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="FiveM Deep Clean Manager" Width="1120" Height="820" MinWidth="900" MinHeight="660" Background="#080F1B" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI">
 <Window.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.35"/></Storyboard></BeginStoryboard></EventTrigger></Window.Triggers>
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="FiveM Deep Clean Manager" FontSize="30" FontWeight="Bold"/><TextBlock Text="Manutenção transparente • Remoção com evidências • Histórico preservado" Foreground="#89A9CD" Margin="0,8,0,20"/></StackPanel>
  <Grid Grid.Row="1">
   <Border x:Name="Welcome" Background="{StaticResource Panel}" CornerRadius="18"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="580"><TextBlock Text="Controle sobre o que fica no seu PC" FontSize="25" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="Feche GTA V e FiveM. Primeiro faremos uma análise; você escolherá o programa e aprovará cada categoria de operação antes de qualquer remoção." TextAlignment="Center" Margin="12,20"/><Button Content="Continuar" Click="Continue_Click" Width="210"/><TextBlock Text="O Windows solicita privilégios de administrador na abertura. Nenhum cheat é identificado apenas pelo nome." Foreground="#89A9CD" Margin="12,18" TextAlignment="Center"/></StackPanel></Border>
   <Grid x:Name="Workspace" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="{StaticResource Panel}" CornerRadius="12" Padding="16"><StackPanel>
     <DockPanel Margin="0,0,0,8"><Button x:Name="FullScanButton" Content="Buscar no PC inteiro" Click="FullScan_Click" DockPanel.Dock="Right"/><TextBox x:Name="SearchName" Text="Loard" Width="180" DockPanel.Dock="Left" ToolTip="Nome para procurar arquivos e pastas. Nada é removido só pelo nome."/><TextBlock Text="Busca nas unidades locais, incluindo Downloads. Você revisa os candidatos antes de autorizar a análise." Margin="12,0" VerticalAlignment="Center"/></DockPanel>
     <TextBlock Text="Ou selecione um programa instalado para analisar" FontSize="17" FontWeight="SemiBold"/>
     <DockPanel Margin="0,10,0,8"><Button Content="Limpar seleção" Click="ClearProgram_Click" DockPanel.Dock="Right"/><ComboBox x:Name="Programs" DisplayMemberPath="Display" MaxDropDownHeight="280" VerticalContentAlignment="Center"/></DockPanel>
     <DockPanel><Button Content="Pasta adicional…" Click="Folder_Click" DockPanel.Dock="Right"/><TextBox x:Name="ExtraFolder" IsReadOnly="True" ToolTip="A pasta adicional só autoriza arquivos com hash do catálogo; não autoriza apagar a pasta inteira."/></DockPanel>
     <DockPanel><Button Content="Catálogo SHA-256…" Click="Catalog_Click" DockPanel.Dock="Right"/><TextBlock x:Name="CatalogInfo" Text="Opcional: catálogo local de hashes conhecidos. Não inclui assinaturas de cheats predefinidas." VerticalAlignment="Center"/></DockPanel>
     <CheckBox x:Name="CacheOption" Content="Incluir apenas cache, server-cache e server-cache-priv do FiveM (sem configurações pessoais)"/>
     <WrapPanel><Button x:Name="AnalyzeButton" Content="Analisar componentes" Click="Analyze_Click"/><Button Content="Integridade GTA V (Steam)" Click="Steam_Click"/><Button Content="Ajuda Rockstar" Click="Rockstar_Click"/></WrapPanel>
    </StackPanel></Border>
    <TextBlock Grid.Row="1" Text="2. Revise as evidências e marque somente o que autoriza remover" Margin="0,14,0,8" FontSize="16"/>
    <DataGrid x:Name="Findings" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" Background="#101D30" RowBackground="#172941" AlternatingRowBackground="#1C304A" Foreground="#E6EFFA" BorderThickness="0" GridLinesVisibility="None" HeadersVisibility="Column" SelectionMode="Single">
     <DataGrid.Resources><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#223D5C"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="8"/></Style></DataGrid.Resources>
     <DataGrid.Columns><DataGridCheckBoxColumn Header="Autorizar" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="70"/><DataGridTextColumn Header="Tipo" Binding="{Binding Kind}" IsReadOnly="True" Width="110"/><DataGridTextColumn Header="Componente / evidência" Binding="{Binding Description}" IsReadOnly="True" Width="*"/><DataGridTextColumn Header="Resultado" Binding="{Binding Outcome}" IsReadOnly="True" Width="165"/></DataGrid.Columns>
    </DataGrid>
    <WrapPanel Grid.Row="3" HorizontalAlignment="Right" Margin="0,12,0,0"><Button x:Name="CleanButton" Content="Confirmar remoção selecionada…" IsEnabled="False" Click="Clean_Click"/><Button x:Name="CancelButton" Content="Cancelar" IsEnabled="False" Click="Cancel_Click"/><Button Content="Abrir relatórios" Click="Reports_Click"/></WrapPanel>
   </Grid>
  </Grid>
  <StackPanel Grid.Row="2" Margin="0,20,0,0"><DockPanel><TextBlock x:Name="Percent" Text="0%" DockPanel.Dock="Right"/><TextBlock x:Name="Status" Text="Pronto para começar"/></DockPanel><ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Height="8" Margin="0,8,0,0" Foreground="#238BFF" Background="#162A43"/></StackPanel>
 </Grid>
</Window>
